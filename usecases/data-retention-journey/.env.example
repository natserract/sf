# ─── Journey Builder (JB) ─────────────────────────────────────────────────────
# Hostname from any /fuelapi/interaction/ request in DevTools Network tab
SFMC_JB_HOST=jbinteractions.s12.marketingcloudapps.com

# Full cookie header value from a JB request (the key varies per account)
# e.g. ff6288631bbb74b54ce9223b62465d85=s%3AB8hRKqx4...
SFMC_JB_COOKIE=

# X-CSRF-Token header from any JB GET request
SFMC_JB_CSRF=

# ─── Marketing Cloud (MC) ─────────────────────────────────────────────────────
# Hostname from the PATCH /contactsmeta/fuelapi/internal/v1/customobjects/ request
SFMC_MC_HOST=mc.s12.marketingcloudapps.com

# Full cookie header value from the MC PATCH request (different key from JB cookie)
# e.g. 567c649970167cc328895c8cba7fd270=s%3A7WfmhRPO...
SFMC_MC_COOKIE=

# X-CSRF-Token header from the MC PATCH request (longer token than JB)
SFMC_MC_CSRF=

# Bearer token from the `authorization: Bearer XXXXXXX` header on the PATCH request
SFMC_BEARER=

# Business unit identifier used to tag all rows/artifacts
SFMC_BUSINESS_UNIT_ID=

# ─── Postgres persistence ──────────────────────────────────────────────────────
SFMC_DB_HOST=127.0.0.1
SFMC_DB_PORT=5432
SFMC_DB_NAME=sfmc_retention
SFMC_DB_USER=postgres
SFMC_DB_PASSWORD=
SFMC_DB_SSLMODE=disable
