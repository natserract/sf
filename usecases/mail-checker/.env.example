## Postgres
DB_DSN=postgres://postgres:postgres@localhost:5432/sf_fetch_all_contacts?sslmode=disable

## API
API_BASE_URL=https://mc.s12.marketingcloudapps.com
PAGE_SIZE=25

## Tuning
MAX_IN_FLIGHT=10 # recommended, most stable
MAX_ATTEMPTS=8
RETRY_INITIAL_MS=1000
RETRY_MAX_MS=60000
LOCK_TIMEOUT_SECONDS=120
IDLE_SLEEP_MS=2000
REAP_INTERVAL_MS=10000

