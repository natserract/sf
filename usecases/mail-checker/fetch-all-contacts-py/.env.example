
DATABASE_URL=postgresql://user:password@localhost:5432/mc_export

# ── Export behaviour ──────────────────────────────────────────────────────────
# Estimated total records — used only by `init` to calculate how many pages
# to enqueue.  Over-estimating is safe; empty pages are marked 'skipped'.
TOTAL_RECORDS_ESTIMATE=19575621

# How many completed pages to buffer before flushing to the CSV writer.
# Lower = more frequent disk writes (safer), higher = fewer I/O calls.
CHUNK_FLUSH_PAGES=500

# How many times to re-prompt for new credentials before giving up on a page.
MAX_REAUTH_ATTEMPTS=5
