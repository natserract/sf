{
  "id": "monthly-report-generator",
  "name": "Monthly Report Generator",
  "deckMode": "full",
  "themeId": "eraspace-kpi",
  "deckStyle": {
    "deckBg": "#f6f8ff",
    "cardBg": "#e6eeff",
    "cardRadius": "18px",
    "textPrimary": "#1e2447",
    "accentPrimary": "#1654b8",
    "fontFamily": "Inter, system-ui, Arial, sans-serif"
  },
  "slideLayouts": {
    "hero": "kpi-hero",
    "summary": "summary-layout"
  },
  "deckCss": ".kpi-hero { border: 1px solid rgba(22,84,184,0.1); } .kpi-card.primary .kpi-value { letter-spacing: 0.02em; }",
  "tasks": [
    {
      "id": "task_personalization_reports_nav",
      "name": "Personalization — Reports menu → Personalization Consumption → MUV cell",
      "page": "https://mc.s12.exacttarget.com/cloud/#app/Personalization/ui/%23/dataset/dsjdsports/reports/productConsumption?timeRange=pastWeek",
      "frameUrlIncludes": "pterafone.us-4.evergage.com",
      "frameResolveTimeoutMs": 120000,
      "steps": [
        {
          "type": "waitFor",
          "operator": "exists",
          "selector": "#navbar-scrollable > ul > li:nth-child(1) > a.ng-scope",
          "requireVisible": true,
          "timeoutMs": 120000
        },
        {
          "id": "hover_reports_nav_first_tab",
          "type": "dom",
          "operator": "hover",
          "selector": "#navbar-scrollable > ul > li:nth-child(1) > a.ng-scope",
          "requireVisible": true,
          "timeoutMs": 120000,
          "hoverSettleMs": 900
        },
        {
          "type": "waitFor",
          "operator": "exists",
          "selector": "#navbar > div.navbar-dropdowns > div:nth-child(1) > div.dropdown-menu.active",
          "requireVisible": true,
          "timeoutMs": 60000
        },
        {
          "type": "waitFor",
          "operator": "exists",
          "selector": "#navbar > div.navbar-dropdowns > div:nth-child(1) > div.dropdown-menu.active a[href*=\"dataset/dsjdsports/reports/productConsumption\"]",
          "requireVisible": true,
          "timeoutMs": 60000,
          "matchIndex": 0
        },
        {
          "id": "click_personalization_consumption_nav",
          "type": "dom",
          "operator": "click",
          "selector": "#navbar > div.navbar-dropdowns > div:nth-child(1) > div.dropdown-menu.active a[href*=\"dataset/dsjdsports/reports/productConsumption\"]",
          "matchIndex": 0,
          "requireVisible": true,
          "timeoutMs": 120000,
          "preClickDelayMs": 200,
          "postClickDelayMs": 2800,
          "clickDispatch": "synthetic"
        },
        {
          "type": "waitFor",
          "operator": "exists",
          "selector": "#muvUsageReportGrid > table > tbody > tr:nth-child(1)",
          "requireVisible": true,
          "timeoutMs": 120000
        },
        {
          "type": "waitFor",
          "operator": "exists",
          "selector": "#muvUsageReportGrid > table > tbody > tr:nth-child(1) > td:nth-child(2)",
          "matchIndex": 0,
          "requireVisible": true,
          "timeoutMs": 120000
        },
        {
          "type": "waitFor",
          "operator": "exists",
          "selector": "#muvUsageReportGrid > table > tbody > tr:nth-child(1) > td:nth-child(3)",
          "matchIndex": 0,
          "requireVisible": true,
          "timeoutMs": 120000
        },
        {
          "id": "prog_active_member_read",
          "type": "dom",
          "operator": "readText",
          "value": "PROG_ACTIVE_MEMBER",
          "selector": "#muvUsageReportGrid > table > tbody > tr:nth-child(1) > td:nth-child(2)",
          "matchIndex": 0,
          "requireVisible": true,
          "timeoutMs": 120000
        },
        {
          "id": "prog_digital_members_read",
          "type": "dom",
          "operator": "readText",
          "value": "PROG_DIGITAL_MEMBERS",
          "selector": "#muvUsageReportGrid > table > tbody > tr:nth-child(1) > td:nth-child(3)",
          "matchIndex": 0,
          "requireVisible": true,
          "timeoutMs": 120000
        }
      ]
    }
  ]
}
